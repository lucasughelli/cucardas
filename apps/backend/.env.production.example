# ====================================================================
# Variables de entorno de PRODUCCIÓN (backend)
# Copiar a la config de secretos de tu host (Railway/Render/Fly), NO commitear con valores reales.
# ====================================================================

PORT=3001
NODE_ENV=production

# Dominios PÚBLICOS y definitivos (HTTPS). NO usar túneles efímeros.
APP_BASE_URL=https://api.tudominio.com
FRONTEND_URL=https://app.tudominio.com

# Postgres gestionado (Neon, Supabase, RDS...). Incluí sslmode=require si tu proveedor lo pide.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cucardas?schema=public&sslmode=require

# Secreto fuerte y aleatorio (ej: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Tiendanube Partner App (de partners.tiendanube.com)
TN_CLIENT_ID=
TN_CLIENT_SECRET=
TN_REDIRECT_URI=https://api.tudominio.com/auth/tiendanube/callback
TN_API_BASE_URL=https://api.tiendanube.com/v1
TN_APP_USER_AGENT=Cucardas App (soporte@tudominio.com)
# ID del Script creado una vez en partners.tiendanube.com (con is_auto_install OFF)
TN_SCRIPT_ID=

# Almacenamiento de objetos PRODUCTIVO (S3 real o Cloudflare R2). NADA de MinIO con claves default.
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=cucardas-assets-prod
# R2/S3 con virtual-host style: poné false. MinIO/path-style: true.
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=https://cdn.tudominio.com

# Clave de cifrado de tokens (32 bytes hex = 64 chars). Generar: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Admin del panel interno: OBLIGATORIOS en producción (el seed falla si faltan).
SEED_ADMIN_EMAIL=tu-admin@tudominio.com
SEED_ADMIN_PASSWORD=

# Período de gracia (días) antes de purgar datos de tiendas desinstaladas.
PURGE_GRACE_DAYS=90
