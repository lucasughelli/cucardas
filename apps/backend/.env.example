# Servidor
PORT=3001
NODE_ENV=development
APP_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Base de datos (coincide con docker-compose.yml)
DATABASE_URL="postgresql://cucardas:cucardas@localhost:5432/cucardas?schema=public"

# JWT propio (sesiones de la app, no de Tiendanube)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Tiendanube Partner App — completar con tus credenciales reales de partners.tiendanube.com
TN_CLIENT_ID=
TN_CLIENT_SECRET=
TN_REDIRECT_URI=http://localhost:3001/auth/tiendanube/callback
TN_API_BASE_URL=https://api.tiendanube.com/v1
TN_APP_USER_AGENT="Cucardas App (soporte@tudominio.com)"

# Almacenamiento S3 / MinIO local (ver docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=cucardas
S3_SECRET_KEY=cucardas123
S3_BUCKET=cucardas-assets
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/cucardas-assets

# Cifrado de tokens de Tiendanube en DB (32 bytes en hex = 64 caracteres)
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-chars-32-bytes

# Opcionales, solo usadas por `npm run seed` para crear el primer usuario admin del panel.
# Si no se completan, se usa admin@cucardas.local / changeme123 (cambiala después de loguearte).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
